# Dev: Vite proxies /bigquery and /api/emulator to this URL (BigQuery REST on bigquery-emulator --port, default 9050)
VITE_PROXY_TARGET=http://127.0.0.1:9050

# Optional: absolute API base for production builds (empty = same origin)
# VITE_API_URL=

# Recommended for local emulator dev (matches data/data.yaml project_id and Taskfile defaults)
# VITE_DEFAULT_PROJECT=local-project

# Optional: X-BigQuery-Emulator-SqlTools-Token when the emulator requires a token for SQL Tools API access
# VITE_SQL_TOOLS_TOKEN=

# Optional dev server port
# VITE_DEV_PORT=5173

# Taskfile only: path to a local bigquery-emulator checkout (default ../bigquery-emulator)
# EMULATOR_ROOT=../bigquery-emulator
