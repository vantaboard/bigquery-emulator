# Dev: Vite proxies /bigquery to this URL (BigQuery REST on bigquery-emulator --port, default 9050)
VITE_PROXY_TARGET=http://127.0.0.1:9050

# Optional: absolute API base for production builds (empty = same origin)
# VITE_API_URL=

# Optional: include this project in the sidebar when it has datasets but is absent from GET /bigquery/v2/projects
# VITE_DEFAULT_PROJECT=local-project

# Optional dev server port
# VITE_DEV_PORT=5173
