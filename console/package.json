{
  "name": "@bigquery-emulator/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-emulator": "task console:dev:all",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "task console:e2e:local",
    "test:e2e:ui": "playwright test --ui",
    "e2e:up": "docker compose -f docker-compose.e2e.yaml up -d --wait --build",
    "e2e:down": "docker compose -f docker-compose.e2e.yaml down -v"
  },
  "dependencies": {
    "@bigquery-emulator/vscode-server": "workspace:*",
    "@bigquery-emulator/vscode-shared": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.0",
    "sql-formatter": "^15.4.11",
    "tailwind-merge": "^2.6.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
