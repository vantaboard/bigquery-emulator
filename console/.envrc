# Project environment (direnv).
#
# Loads dev defaults when you cd into this repo. First time:
#   direnv allow
#
# Personal overrides: create .envrc.local (gitignored) or export before cd.

# Vite dev proxy → local bigquery-emulator REST + SQL Tools
export VITE_PROXY_TARGET="${VITE_PROXY_TARGET:-http://127.0.0.1:9050}"

# Sidebar project when absent from GET /bigquery/v2/projects (matches data/data.yaml)
export VITE_DEFAULT_PROJECT="${VITE_DEFAULT_PROJECT:-local-project}"

# Taskfile: sibling bigquery-emulator checkout
export EMULATOR_ROOT="${EMULATOR_ROOT:-${PWD}/../bigquery-emulator}"

# Optional — uncomment or set in .envrc.local:
# export VITE_API_URL=
# export VITE_SQL_TOOLS_TOKEN=
# export VITE_DEV_PORT=5173
# export VITE_ALLOW_EMULATOR_PROJECT_ADMIN=true

source_env_if_exists .envrc.local
